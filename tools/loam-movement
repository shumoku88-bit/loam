#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

binary=".lake/build/bin/loamMovement"

binary_is_current() {
  [[ -x "$binary" ]] || return 1

  for input in \
    Loam/MovementCli.lean \
    Loam/Persistence.lean \
    Loam/WriterOwnership.lean \
    lakefile.lean lake-manifest.json lean-toolchain; do
    if [[ -e "$input" && "$input" -nt "$binary" ]]; then
      return 1
    fi
  done

  if find Loam/Core -type f -name '*.lean' -newer "$binary" -print -quit | grep -q .; then
    return 1
  fi

  return 0
}

if ! binary_is_current; then
  echo "Building LOAM movement..." >&2
  build_log="$(mktemp -t loam-movement-build.XXXXXX)"
  if lake build loamMovement >"$build_log" 2>&1; then
    rm -f "$build_log"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    exit 1
  fi
fi

exec "$binary" "$@"
