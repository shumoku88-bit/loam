#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "usage: tools/check-three-stream-dogfood DATA_ROOT [START END]" >&2
  exit 2
fi

data_root="$1"
start="${2:-2026-08-17}"
end="${3:-2026-10-15}"
cycle_observed_at="${LOAM_THREE_STREAM_OBSERVED_AT:-2026-09-08}"
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
observer="$repo_root/.lake/build/bin/loamHouseholdObservation"
projector="$repo_root/tools/three-stream-projection.py"
cycle_observer="$repo_root/Loam/Tests/ThreeStreamCycleObservation.lean"

if [[ ! -x "$observer" ]]; then
  echo "missing $observer; run: lake build loamHouseholdObservation" >&2
  exit 2
fi
if [[ ! -d "$data_root" ]]; then
  echo "data root not found: $data_root" >&2
  exit 2
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
streams="$work/streams"
rebuilt="$work/rebuilt"

printf '%s\n' '== exact selected-byte round trip =='
python3 "$projector" check "$data_root" "$work/exact-check"
python3 "$projector" pack "$data_root" "$streams"
python3 "$projector" unpack "$streams" "$rebuilt" --support-from "$data_root"

printf '%s\n' '== HOBS1 original =='
if ! "$observer" "$data_root" "$start" "$end" >"$work/original.hobs1" 2>"$work/original.hobs1.err"; then
  cat "$work/original.hobs1.err" >&2
  echo 'original HOBS1 observation failed' >&2
  exit 1
fi

printf '%s\n' '== HOBS1 rebuilt =='
if ! "$observer" "$rebuilt" "$start" "$end" >"$work/rebuilt.hobs1" 2>"$work/rebuilt.hobs1.err"; then
  cat "$work/rebuilt.hobs1.err" >&2
  echo 'rebuilt HOBS1 observation failed' >&2
  exit 1
fi

printf '%s\n' '== HOBS1 diff =='
diff -u "$work/original.hobs1" "$work/rebuilt.hobs1"

printf '%s\n' '== current CycleBudget observation original =='
if ! (
  cd "$repo_root"
  lake env lean --run "$cycle_observer" "$data_root" "$cycle_observed_at"
) >"$work/original.cycle" 2>&1; then
  cat "$work/original.cycle" >&2
  echo 'original current CycleBudget observation failed' >&2
  exit 1
fi

printf '%s\n' '== current CycleBudget observation rebuilt =='
if ! (
  cd "$repo_root"
  lake env lean --run "$cycle_observer" "$rebuilt" "$cycle_observed_at"
) >"$work/rebuilt.cycle" 2>&1; then
  cat "$work/rebuilt.cycle" >&2
  echo 'rebuilt current CycleBudget observation failed' >&2
  exit 1
fi

printf '%s\n' '== current CycleBudget observation diff =='
diff -u "$work/original.cycle" "$work/rebuilt.cycle"

printf '%s\n' \
  "three-stream dogfood parity passed" \
  "  HOBS1: Balance / Budget / Capacity identical" \
  "  CycleBudgetReview: Funding / CurrentCoverage / Scheduled pressure identical"
