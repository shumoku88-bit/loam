#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  printf '%s\n' 'usage: private-plan-realization-shadow ACTUAL_JOURNAL PLAN_JOURNAL' >&2
  exit 2
fi

actual=$1
plan=$2

if [[ ! -f "$actual" || ! -f "$plan" ]]; then
  printf '%s\n' 'LOAM private plan realization shadow: source file not found' >&2
  exit 2
fi

umask 077

tmp_root=${TMPDIR:-/tmp}
tmpdir=$(mktemp -d "${tmp_root%/}/loam-plan-realization.XXXXXX")
chmod 700 "$tmpdir"
trap 'rm -rf "$tmpdir"' EXIT

result="$tmpdir/result"
parser_err="$tmpdir/parser.err"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    printf '%s\n' 'LOAM private plan realization shadow: SHA-256 tool unavailable' >&2
    return 2
  fi
}

actual_before=$(sha256_file "$actual")
plan_before=$(sha256_file "$plan")

set +e
python3 - "$actual" "$plan" >"$result" 2>"$parser_err" <<'PY'
from __future__ import annotations

from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
import re
import sys

HEADER = re.compile(r"^(\d{4}-\d{2}-\d{2})(?:\s|$)")
PLAN_ID = re.compile(r"^;\s*plan-id\s*:\s*(\S(?:.*\S)?)\s*$")
INTEGER = re.compile(r"^[+-]?\d+$")

Posting = tuple[str, str, int]
Coordinate = tuple[str, str]


@dataclass
class Record:
    date: str
    plan_ids: list[str] = field(default_factory=list)
    postings: list[Posting] = field(default_factory=list)
    unsupported_posting: bool = False


@dataclass
class Scan:
    records: list[Record]


def scan(path: Path) -> Scan:
    records: list[Record] = []
    current: Record | None = None

    with path.open("r", encoding="utf-8") as handle:
        for raw in handle:
            line = raw.rstrip("\n")
            stripped = line.strip()
            if not stripped:
                continue

            indented = len(line) != len(line.lstrip())
            if not indented:
                header = HEADER.match(stripped)
                if header:
                    current = Record(date=header.group(1))
                    records.append(current)
                else:
                    current = None
                continue

            if current is None:
                continue

            plan_id = PLAN_ID.match(stripped)
            if plan_id:
                current.plan_ids.append(plan_id.group(1))
                continue

            if stripped.startswith(";"):
                continue

            parts = stripped.split()
            if len(parts) < 3 or not INTEGER.fullmatch(parts[-2]):
                current.unsupported_posting = True
                continue

            locus = " ".join(parts[:-2])
            if not locus:
                current.unsupported_posting = True
                continue

            current.postings.append((locus, parts[-1], int(parts[-2])))

    return Scan(records=records)


def refuse(reason: str) -> None:
    print("LOAM private plan realization shadow: REFUSED")
    print(f"reason: {reason}")
    print("private identities/content: withheld")
    raise SystemExit(2)


def coordinates(record: Record) -> Counter[Coordinate]:
    return Counter((locus, measure) for locus, measure, _ in record.postings)


def physical_delta(plan_record: Record, actual_record: Record) -> str:
    if (
        plan_record.unsupported_posting
        or actual_record.unsupported_posting
        or not plan_record.postings
        or not actual_record.postings
    ):
        refuse("linked record has unsupported physical shape")

    plan_exact = Counter(plan_record.postings)
    actual_exact = Counter(actual_record.postings)
    if plan_exact == actual_exact:
        return "exact"

    if coordinates(plan_record) == coordinates(actual_record):
        return "quantity-different"

    return "shape-different"


def coordinate_correspondence(plan_record: Record, actual_record: Record) -> str:
    plan_shape = coordinates(plan_record)
    actual_shape = coordinates(actual_record)
    if plan_shape != actual_shape:
        refuse("coordinate correspondence requested for different physical shape")

    if all(count == 1 for count in plan_shape.values()):
        return "unique"
    return "ambiguous"


def time_relation(plan_record: Record, actual_record: Record) -> str:
    if actual_record.date < plan_record.date:
        return "before"
    if actual_record.date > plan_record.date:
        return "after"
    return "same-day"


actual = scan(Path(sys.argv[1]))
plan = scan(Path(sys.argv[2]))

if any(len(record.plan_ids) > 1 for record in plan.records):
    refuse("plan record has multiple plan-id fields")
if any(len(record.plan_ids) > 1 for record in actual.records):
    refuse("actual record has multiple plan-id fields")

plan_records = {
    record.plan_ids[0]: record
    for record in plan.records
    if len(record.plan_ids) == 1
}
plan_id_count = sum(1 for record in plan.records if len(record.plan_ids) == 1)
if len(plan_records) != plan_id_count:
    refuse("plan-id is not unique in plan source")

actual_refs = [
    (record.plan_ids[0], record)
    for record in actual.records
    if len(record.plan_ids) == 1
]
actual_ref_counts = Counter(plan_id for plan_id, _ in actual_refs)
plan_set = set(plan_records)

matched_refs = sum(count for key, count in actual_ref_counts.items() if key in plan_set)
dangling_refs = sum(count for key, count in actual_ref_counts.items() if key not in plan_set)
plans_zero = sum(1 for key in plan_set if actual_ref_counts[key] == 0)
plans_one = sum(1 for key in plan_set if actual_ref_counts[key] == 1)
plans_many = sum(1 for key in plan_set if actual_ref_counts[key] >= 2)

matrix: Counter[tuple[str, str]] = Counter()
effect_correspondence: Counter[str] = Counter()
for plan_id, actual_record in actual_refs:
    plan_record = plan_records.get(plan_id)
    if plan_record is None:
        continue
    delta = physical_delta(plan_record, actual_record)
    matrix[(time_relation(plan_record, actual_record), delta)] += 1
    if delta == "quantity-different":
        effect_correspondence[coordinate_correspondence(plan_record, actual_record)] += 1

print("LOAM private plan realization shadow")
print(f"plan records observed: {len(plan.records)}")
print(f"plan records with explicit plan-id: {plan_id_count}")
print(f"actual records observed: {len(actual.records)}")
print(f"actual records with explicit plan reference: {len(actual_refs)}")
print(f"actual plan references resolving to plan source: {matched_refs}")
print(f"actual plan references missing from plan source: {dangling_refs}")
print(f"plans with no explicit actual reference: {plans_zero}")
print(f"plans with exactly one explicit actual reference: {plans_one}")
print(f"plans with multiple explicit actual references: {plans_many}")
print(f"matched explicit pairs compared: {sum(matrix.values())}")
print("time x physical delta:")
for timing in ("before", "same-day", "after"):
    print(
        f"  {timing}: "
        f"exact={matrix[(timing, 'exact')]} "
        f"same-shape-quantity-different={matrix[(timing, 'quantity-different')]} "
        f"shape-different={matrix[(timing, 'shape-different')]}"
    )
print("quantity-different Effect correspondence by Locus/Measure coordinate:")
print(f"  query-local unique: {effect_correspondence['unique']}")
print(f"  query-local ambiguous: {effect_correspondence['ambiguous']}")
print("  coordinate correspondence is not stable Effect identity")
print("private identities/content: withheld")
PY
status=$?
set -e

actual_after=$(sha256_file "$actual")
plan_after=$(sha256_file "$plan")

if [[ "$actual_before" != "$actual_after" || "$plan_before" != "$plan_after" ]]; then
  printf '%s\n' 'LOAM private plan realization shadow: REFUSED'
  printf '%s\n' 'sources unchanged: no'
  printf '%s\n' 'private identities/content: withheld'
  exit 2
fi

if [[ $status -ne 0 ]]; then
  cat "$result"
  printf '%s\n' 'sources unchanged: yes'
  printf '%s\n' 'private parser stderr: withheld'
  exit "$status"
fi

cat "$result"
printf '%s\n' 'sources unchanged: yes'
