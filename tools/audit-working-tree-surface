#!/usr/bin/env python3
"""Count the complete tracked UTF-8 working-tree surface by current repository area."""

from __future__ import annotations

from collections import defaultdict
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]


def tracked_files() -> list[Path]:
    result = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=ROOT,
        check=True,
        capture_output=True,
    )
    return [
        ROOT / raw.decode("utf-8")
        for raw in result.stdout.split(b"\0")
        if raw
    ]


def area(path: Path) -> str:
    rel = path.relative_to(ROOT)
    parts = rel.parts
    if not parts:
        return "(root)"
    if parts[0] == "Loam" and len(parts) > 1:
        if parts[1] == "Tests":
            return "Loam/Tests"
        if parts[1] == "Observations":
            return "Loam/Observations"
        return "Loam/practical"
    return parts[0] if len(parts) > 1 else "(root)"


def suffix(path: Path) -> str:
    return path.suffix.lower() or "(none)"


files = tracked_files()
by_area: dict[str, list[int]] = defaultdict(lambda: [0, 0, 0])
by_suffix: dict[str, list[int]] = defaultdict(lambda: [0, 0])
text_files = 0
binary_files = 0
total_lines = 0
total_bytes = 0

for path in files:
    data = path.read_bytes()
    total_bytes += len(data)
    if b"\0" in data:
        binary_files += 1
        continue
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        binary_files += 1
        continue

    text_files += 1
    lines = text.count("\n")
    if text and not text.endswith("\n"):
        lines += 1
    total_lines += lines

    bucket = by_area[area(path)]
    bucket[0] += 1
    bucket[1] += lines
    bucket[2] += len(data)

    ext = suffix(path)
    by_suffix[ext][0] += 1
    by_suffix[ext][1] += lines

print(f"tracked files: {len(files)}")
print(f"text files:    {text_files}")
print(f"binary files:  {binary_files}")
print(f"text lines:    {total_lines}")
print(f"tracked bytes: {total_bytes}")
print()
print(f"{'area':<24} {'lines':>10} {'files':>8} {'bytes':>12}")
print(f"{'-' * 24} {'-' * 10} {'-' * 8} {'-' * 12}")
for name, (count, lines, size) in sorted(
    by_area.items(), key=lambda item: (-item[1][1], item[0])
):
    print(f"{name:<24} {lines:>10} {count:>8} {size:>12}")

print()
print(f"{'suffix':<12} {'lines':>10} {'files':>8}")
print(f"{'-' * 12} {'-' * 10} {'-' * 8}")
for name, (count, lines) in sorted(
    by_suffix.items(), key=lambda item: (-item[1][1], item[0])
):
    print(f"{name:<12} {lines:>10} {count:>8}")
