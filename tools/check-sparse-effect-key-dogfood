#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "usage: tools/check-sparse-effect-key-dogfood DATA_ROOT [START END]" >&2
  exit 2
fi

data_root="$1"
start="${2:-2026-08-17}"
end="${3:-2026-10-15}"
cycle_observed_at="${LOAM_SPARSE_EFFECT_KEY_OBSERVED_AT:-2026-09-08}"
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
observer="$repo_root/.lake/build/bin/loamHouseholdObservation"
projector="$repo_root/tools/sparse-effect-key-projection.py"
actual_observer="$repo_root/Loam/Tests/SparseEffectKeyActualObservation.lean"
relation_observer="$repo_root/Loam/Tests/SparseEffectKeyRelationObservation.lean"
cycle_observer="$repo_root/Loam/Tests/ThreeStreamCycleObservation.lean"

if [[ ! -x "$observer" ]]; then
  echo "missing $observer; run: lake build loamHouseholdObservation" >&2
  exit 2
fi
if [[ ! -d "$data_root" ]]; then
  echo "data root not found: $data_root" >&2
  exit 2
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
sparse="$work/actual.sparse"
rebuilt="$work/rebuilt"

printf '%s\n' '== sparse EffectKey semantic round trip =='
python3 "$projector" check "$data_root" "$work/semantic-check"
python3 "$projector" pack "$data_root" "$sparse"
cp -a "$data_root" "$rebuilt"
python3 "$projector" apply "$sparse" "$rebuilt"

printf '%s\n' '== Actual semantic observation =='
(
  cd "$repo_root"
  lake env lean --run "$actual_observer" "$data_root"
) >"$work/original.actual"
(
  cd "$repo_root"
  lake env lean --run "$actual_observer" "$rebuilt"
) >"$work/rebuilt.actual"
diff -u "$work/original.actual" "$work/rebuilt.actual"

printf '%s\n' '== Relation source observation =='
(
  cd "$repo_root"
  lake env lean --run "$relation_observer" "$data_root"
) >"$work/original.relation"
(
  cd "$repo_root"
  lake env lean --run "$relation_observer" "$rebuilt"
) >"$work/rebuilt.relation"
diff -u "$work/original.relation" "$work/rebuilt.relation"

printf '%s\n' '== HOBS1 =='
"$observer" "$data_root" "$start" "$end" >"$work/original.hobs1"
"$observer" "$rebuilt" "$start" "$end" >"$work/rebuilt.hobs1"
diff -u "$work/original.hobs1" "$work/rebuilt.hobs1"

printf '%s\n' '== CycleBudgetReview =='
(
  cd "$repo_root"
  lake env lean --run "$cycle_observer" "$data_root" "$cycle_observed_at"
) >"$work/original.cycle" 2>&1
(
  cd "$repo_root"
  lake env lean --run "$cycle_observer" "$rebuilt" "$cycle_observed_at"
) >"$work/rebuilt.cycle" 2>&1
diff -u "$work/original.cycle" "$work/rebuilt.cycle"

printf '%s\n' \
  'sparse EffectKey dogfood parity passed' \
  '  Actual: date/description/locus/measure/quantity identical' \
  '  Relation: retained source Event/EffectKey/payload identical' \
  '  HOBS1 and CycleBudgetReview identical'
