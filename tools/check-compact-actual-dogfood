#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "usage: tools/check-compact-actual-dogfood DATA_ROOT [START END]" >&2
  exit 2
fi

data_root="$1"
start="${2:-2026-08-17}"
end="${3:-2026-10-15}"
cycle_observed_at="${LOAM_COMPACT_ACTUAL_OBSERVED_AT:-2026-09-08}"
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
observer="$repo_root/.lake/build/bin/loamHouseholdObservation"
projector="$repo_root/tools/compact-actual-projection.py"
cycle_observer="$repo_root/Loam/Tests/ThreeStreamCycleObservation.lean"
actual_observer="$repo_root/Loam/Tests/CompactActualObservation.lean"

if [[ ! -x "$observer" ]]; then
  echo "missing $observer; run: lake build loamHouseholdObservation" >&2
  exit 2
fi
if [[ ! -d "$data_root" ]]; then
  echo "data root not found: $data_root" >&2
  exit 2
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
compact="$work/actual.compact"
rebuilt="$work/rebuilt"

printf '%s\n' '== compact Actual semantic round trip =='
python3 "$projector" check "$data_root" "$work/semantic-check"
python3 "$projector" pack "$data_root" "$compact"
cp -a "$data_root" "$rebuilt"
python3 "$projector" apply "$compact" "$rebuilt"

printf '%s\n' '== ActualReview original =='
(
  cd "$repo_root"
  lake env lean --run "$actual_observer" "$data_root"
) >"$work/original.actual"

printf '%s\n' '== ActualReview rebuilt =='
(
  cd "$repo_root"
  lake env lean --run "$actual_observer" "$rebuilt"
) >"$work/rebuilt.actual"

printf '%s\n' '== ActualReview diff =='
diff -u "$work/original.actual" "$work/rebuilt.actual"

printf '%s\n' '== HOBS1 original =='
"$observer" "$data_root" "$start" "$end" >"$work/original.hobs1"
printf '%s\n' '== HOBS1 rebuilt =='
"$observer" "$rebuilt" "$start" "$end" >"$work/rebuilt.hobs1"
printf '%s\n' '== HOBS1 diff =='
diff -u "$work/original.hobs1" "$work/rebuilt.hobs1"

printf '%s\n' '== current CycleBudget observation original =='
(
  cd "$repo_root"
  lake env lean --run "$cycle_observer" "$data_root" "$cycle_observed_at"
) >"$work/original.cycle"
printf '%s\n' '== current CycleBudget observation rebuilt =='
(
  cd "$repo_root"
  lake env lean --run "$cycle_observer" "$rebuilt" "$cycle_observed_at"
) >"$work/rebuilt.cycle"
printf '%s\n' '== current CycleBudget observation diff =='
diff -u "$work/original.cycle" "$work/rebuilt.cycle"

printf '%s\n' \
  "compact Actual dogfood parity passed" \
  "  ActualReview: Event/date/description/frontier/EffectKey/effects identical" \
  "  HOBS1: Balance / Budget / Capacity identical" \
  "  CycleBudgetReview: Funding / CurrentCoverage / Scheduled pressure identical"
