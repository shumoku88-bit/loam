#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fnmatch
import json
from pathlib import Path
import subprocess
import sys

MANIFEST = Path("verification/ci/lean-qualification-cases.json")


def load_manifest() -> dict:
    return json.loads(MANIFEST.read_text(encoding="utf-8"))


def git_changed_paths(event: str, event_file: Path) -> tuple[list[str], str | None]:
    payload = json.loads(event_file.read_text(encoding="utf-8"))
    if event == "workflow_dispatch":
        return [], None
    if event == "pull_request":
        base = payload["pull_request"]["base"]["sha"]
        head = payload["pull_request"]["head"]["sha"]
        result = subprocess.run(
            ["git", "diff", "--name-only", f"{base}...{head}"],
            check=True,
            text=True,
            capture_output=True,
        )
        return [line for line in result.stdout.splitlines() if line], None
    if event == "push":
        before = payload["before"]
        after = payload["after"]
        branch = payload.get("ref", "").removeprefix("refs/heads/")
        if set(before) == {"0"}:
            command = ["git", "diff-tree", "--root", "--no-commit-id", "--name-only", "-r", after]
        else:
            command = ["git", "diff", "--name-only", before, after]
        result = subprocess.run(command, check=True, text=True, capture_output=True)
        return [line for line in result.stdout.splitlines() if line], branch
    raise SystemExit(f"unsupported GitHub event: {event}")


def matches(path: str, pattern: str) -> bool:
    return fnmatch.fnmatchcase(path, pattern)


def select_cases(manifest: dict, changed_paths: list[str], event: str, branch: str | None) -> list[dict]:
    cases = manifest["cases"]
    if event == "workflow_dispatch":
        return cases

    eligible = cases
    if event == "push":
        if not branch:
            raise SystemExit("push selection requires a branch")
        eligible = [
            case
            for case in cases
            if any(fnmatch.fnmatchcase(branch, pattern) for pattern in case["pushBranches"])
        ]

    shared_changed = any(
        matches(path, pattern)
        for path in changed_paths
        for pattern in manifest["sharedPaths"]
    )
    if shared_changed:
        return eligible

    selected: list[dict] = []
    for case in eligible:
        if any(
            matches(path, pattern)
            for path in changed_paths
            for pattern in case["paths"]
        ):
            selected.append(case)
    return selected


def render(selected: list[dict], output_format: str) -> str:
    if output_format == "ids":
        return json.dumps([case["id"] for case in selected], separators=(",", ":"))
    if output_format == "matrix":
        include = [
            {
                "id": case["id"],
                "jobName": case["jobName"],
                "buildArgs": case["buildArgs"],
            }
            for case in selected
        ]
        return json.dumps({"include": include}, separators=(",", ":"))
    raise SystemExit(f"unsupported output format: {output_format}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--event",
        choices=["pull_request", "push", "workflow_dispatch"],
        default="pull_request",
    )
    parser.add_argument("--event-file", type=Path)
    parser.add_argument("--branch")
    parser.add_argument("--paths", nargs="*")
    parser.add_argument("--format", choices=["ids", "matrix"], default="ids")
    args = parser.parse_args()

    if args.paths is not None:
        changed_paths = args.paths
        branch = args.branch
    elif args.event_file is not None:
        changed_paths, derived_branch = git_changed_paths(args.event, args.event_file)
        branch = args.branch or derived_branch
    else:
        parser.error("provide --event-file or --paths")

    selected = select_cases(load_manifest(), changed_paths, args.event, branch)
    print(render(selected, args.format))
    return 0


if __name__ == "__main__":
    sys.exit(main())
