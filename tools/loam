#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

binary=".lake/build/bin/loam"
binary_stamp=".lake/build/.loam-wrapper-build-stamp"
capacity_binary=".lake/build/bin/loamCapacity"
capacity_stamp=".lake/build/.loam-capacity-wrapper-build-stamp"
daily_quantity_binary=".lake/build/bin/loamDailyQuantity"
daily_quantity_stamp=".lake/build/.loam-daily-quantity-wrapper-build-stamp"
shadow_binary=".lake/build/bin/loamShadowAudit"
shadow_stamp=".lake/build/.loam-shadow-audit-wrapper-build-stamp"
shadow_quantity_binary=".lake/build/bin/loamShadowQuantity"
shadow_quantity_stamp=".lake/build/.loam-shadow-quantity-wrapper-build-stamp"

binary_is_current() {
  [[ -x "$binary" && -e "$binary_stamp" ]] || return 1

  if find Loam -type f -name '*.lean' -newer "$binary_stamp" -print -quit | grep -q .; then
    return 1
  fi

  for input in lakefile.lean lake-manifest.json lean-toolchain; do
    if [[ -e "$input" && "$input" -nt "$binary_stamp" ]]; then
      return 1
    fi
  done

  return 0
}

capacity_binary_is_current() {
  [[ -x "$capacity_binary" && -e "$capacity_stamp" ]] || return 1

  for input in \
    Loam/CapacityCli.lean \
    Loam/CapacityPersistence.lean \
    Loam/Application/CapacityInspection.lean \
    Loam/Core/BalancedMovement.lean \
    Loam/Core/Capacity.lean \
    Loam/Core/CapacityMemory.lean \
    Loam/Core/Purpose.lean \
    Loam/Persistence.lean \
    Loam/WriterOwnership.lean \
    lakefile.lean lake-manifest.json lean-toolchain; do
    if [[ -e "$input" && "$input" -nt "$capacity_stamp" ]]; then
      return 1
    fi
  done

  return 0
}

daily_quantity_binary_is_current() {
  [[ -x "$daily_quantity_binary" && -e "$daily_quantity_stamp" ]] || return 1

  for input in \
    Loam/DailyQuantityCli.lean \
    Loam/BalanceViewConfig.lean \
    Loam/BasisCutPersistence.lean \
    Loam/QuantityBasisCorrectionCli.lean \
    Loam/QuantityBasisCorrectionPersistence.lean \
    Loam/QuantityBasisPersistence.lean \
    Loam/Application/BasisCut.lean \
    Loam/Application/CorrectionFrontier.lean \
    Loam/Application/CurrentQuantity.lean \
    Loam/Application/QuantityBasisFrontier.lean \
    Loam/Core/QuantityBasisCorrectionMemory.lean \
    Loam/Core/QuantityBasisMemory.lean \
    lakefile.lean lake-manifest.json lean-toolchain; do
    if [[ -e "$input" && "$input" -nt "$daily_quantity_stamp" ]]; then
      return 1
    fi
  done

  return 0
}

shadow_binary_is_current() {
  [[ -x "$shadow_binary" && -e "$shadow_stamp" ]] || return 1

  for input in Loam/ShadowAuditCli.lean lakefile.lean lake-manifest.json lean-toolchain; do
    if [[ -e "$input" && "$input" -nt "$shadow_stamp" ]]; then
      return 1
    fi
  done

  return 0
}

shadow_quantity_binary_is_current() {
  [[ -x "$shadow_quantity_binary" && -e "$shadow_quantity_stamp" ]] || return 1

  if [[ Loam/ShadowQuantityCli.lean -nt "$shadow_quantity_stamp" ]]; then
    return 1
  fi

  if find Loam/Core -type f -name '*.lean' -newer "$shadow_quantity_stamp" -print -quit | grep -q .; then
    return 1
  fi

  for input in lakefile.lean lake-manifest.json lean-toolchain; do
    if [[ -e "$input" && "$input" -nt "$shadow_quantity_stamp" ]]; then
      return 1
    fi
  done

  return 0
}

run_loam() {
  if binary_is_current; then
    "$binary" "$@"
    return $?
  fi

  echo "Building LOAM..." >&2
  local build_log
  build_log="$(mktemp -t loam-build.XXXXXX)"
  if lake build loam >"$build_log" 2>&1; then
    touch "$binary_stamp"
    rm -f "$build_log"
    "$binary" "$@"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    return 1
  fi
}

run_capacity() {
  if capacity_binary_is_current; then
    "$capacity_binary" "$@"
    return $?
  fi

  echo "Building LOAM spending capacity..." >&2
  local build_log
  build_log="$(mktemp -t loam-capacity-build.XXXXXX)"
  if lake build loamCapacity >"$build_log" 2>&1; then
    touch "$capacity_stamp"
    rm -f "$build_log"
    "$capacity_binary" "$@"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    return 1
  fi
}

run_daily_quantity() {
  if daily_quantity_binary_is_current; then
    "$daily_quantity_binary" "$@"
    return $?
  fi

  echo "Building LOAM daily quantity..." >&2
  local build_log
  build_log="$(mktemp -t loam-daily-quantity-build.XXXXXX)"
  if lake build loamDailyQuantity >"$build_log" 2>&1; then
    touch "$daily_quantity_stamp"
    rm -f "$build_log"
    "$daily_quantity_binary" "$@"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    return 1
  fi
}

run_shadow_audit() {
  if shadow_binary_is_current; then
    exec "$shadow_binary" "$@"
  fi

  echo "Building LOAM shadow audit..." >&2
  local build_log
  build_log="$(mktemp -t loam-shadow-build.XXXXXX)"
  if lake build loamShadowAudit >"$build_log" 2>&1; then
    touch "$shadow_stamp"
    rm -f "$build_log"
    exec "$shadow_binary" "$@"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    exit 1
  fi
}

run_shadow_quantity() {
  if shadow_quantity_binary_is_current; then
    exec "$shadow_quantity_binary" "$@"
  fi

  echo "Building LOAM stateless shadow quantity..." >&2
  local build_log
  build_log="$(mktemp -t loam-shadow-quantity-build.XXXXXX)"
  if lake build loamShadowQuantity >"$build_log" 2>&1; then
    touch "$shadow_quantity_stamp"
    rm -f "$build_log"
    exec "$shadow_quantity_binary" "$@"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    exit 1
  fi
}

print_help() {
  cat <<'EOF'
LOAM practical dogfood

Record one balanced JPY movement:
  ./tools/loam movement MEMORY_FILE

Move JPY spending capacity:
  ./tools/loam capacity CAPACITY_FILE

Show spending capacity:
  ./tools/loam capacity show CAPACITY_FILE

Review recorded facts:
  ./tools/loam review MEMORY_FILE

Show recorded quantities:
  ./tools/loam summary MEMORY_FILE

Correct a movement append-only:
  ./tools/loam correct MEMORY_FILE CORRECTION_FILE

Starting quantities and balance projections:
  ./tools/loam starting-quantity BASIS_FILE
  ./tools/loam correct-starting-quantity BASIS_FILE BASIS_CORRECTION_FILE
  ./tools/loam balances EVENT_MEMORY EVENT_CORRECTIONS BASIS_FILE [BASIS_CORRECTIONS] [BALANCE_VIEW] [BASIS_CUT]

For lower-level commands:
  ./tools/loam help low-level
EOF
}

run_menu_action() {
  "$@" || true
}

if [[ "${1:-}" == "shadow-audit" ]]; then
  shift
  run_shadow_audit "$@"
fi

if [[ "${1:-}" == "shadow-quantity" ]]; then
  shift
  run_shadow_quantity "$@"
fi

if [[ "${1:-}" == "movement" ]]; then
  shift
  exec "$root/tools/loam-movement" "$@"
fi

if [[ "${1:-}" == "capacity" ]]; then
  shift
  run_capacity "$@" || exit $?
  exit 0
fi

if [[ "${1:-}" == "help" && "${2:-}" != "low-level" ]]; then
  print_help
  exit 0
fi

if [[ "${1:-}" == "starting-quantity" || "${1:-}" == "correct-starting-quantity" || "${1:-}" == "balances" || "${1:-}" == "current" ]]; then
  run_daily_quantity "$@" || exit $?
  exit 0
fi

if [[ $# -eq 0 ]]; then
  if [[ -n "${LOAM_DATA_DIR:-}" ]]; then
    requested_data_dir="$LOAM_DATA_DIR"
    data_label="$LOAM_DATA_DIR"
  else
    requested_data_dir="$root/../loam-data"
    data_label="../loam-data"
  fi

  if ! mkdir -p "$requested_data_dir"; then
    echo "loam: could not prepare data directory: $requested_data_dir" >&2
    exit 2
  fi
  data_dir="$(cd "$requested_data_dir" && pwd)"

  memory_file="$data_dir/memory.loam"
  correction_file="$data_dir/corrections.loam"
  basis_file="$data_dir/basis.loam"
  basis_correction_file="$data_dir/basis-corrections.loam"
  balance_view_file="$data_dir/balance-view.tsv"
  basis_cut_file="$data_dir/basis-cut.tsv"
  capacity_file="$data_dir/capacity.loam"

  while true; do
    printf 'LOAM\nData: %s\n\n' "$data_label"
    cat <<'EOF'
What do you want to do?
1. Record movement
2. Review what I recorded
3. Show recorded quantities
4. Correct a movement
5. Show effective quantities
6. Review correction integrity
7. Set a starting balance
8. Show balances
9. Correct a starting balance
10. Move spending capacity
11. Show spending capacity
q. Quit
EOF
    printf '> '
    if ! IFS= read -r choice; then
      break
    fi

    case "$choice" in
      1)
        run_menu_action "$root/tools/loam-movement" "$memory_file"
        ;;
      2)
        if [[ ! -e "$memory_file" ]]; then
          echo "Nothing recorded yet."
        else
          run_menu_action run_loam review "$memory_file"
        fi
        ;;
      3)
        if [[ ! -e "$memory_file" ]]; then
          echo "Nothing recorded yet."
        else
          run_menu_action run_loam summary "$memory_file"
        fi
        ;;
      4)
        run_menu_action run_loam correct "$memory_file" "$correction_file"
        ;;
      5)
        run_menu_action run_loam effective "$memory_file" "$correction_file"
        ;;
      6)
        run_menu_action run_loam correction-integrity "$memory_file" "$correction_file"
        ;;
      7)
        run_menu_action run_daily_quantity starting-quantity "$basis_file"
        ;;
      8)
        run_menu_action run_daily_quantity balances "$memory_file" "$correction_file" "$basis_file" "$basis_correction_file" "$balance_view_file" "$basis_cut_file"
        ;;
      9)
        run_menu_action run_daily_quantity correct-starting-quantity "$basis_file" "$basis_correction_file"
        ;;
      10)
        run_menu_action run_capacity "$capacity_file"
        ;;
      11)
        run_menu_action run_capacity show "$capacity_file"
        ;;
      q|Q)
        break
        ;;
      *)
        echo "loam: choice not understood" >&2
        ;;
    esac

    echo
  done

  exit 0
fi

run_loam "$@"
