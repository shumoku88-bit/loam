#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"

hash_files() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$@"
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$@"
  else
    return 1
  fi
}

target_input_fingerprint() {
  local bin="$root/.lake/build/bin/$1"
  local rsp="$bin.rsp" object source
  local sources=()
  [[ -f "$rsp" ]] || return 1

  # Lake's linker inventory bounds the input set. Missing/deleted sources refuse
  # the shortcut; changed imports change the importing source's content hash.
  while IFS= read -r object || [[ -n "$object" ]]; do
    object="${object#\"}"
    object="${object%\"}"
    case "$object" in
      "$root/.lake/build/ir/"*.c.o.export)
        source="$root/${object#"$root/.lake/build/ir/"}"
        ;;
      .lake/build/ir/*.c.o.export)
        source="$root/${object#.lake/build/ir/}"
        ;;
      *) continue ;;
    esac
    sources+=("${source%.c.o.export}.lean")
  done < "$rsp"
  [[ "${#sources[@]}" != "0" ]] || return 1
  hash_files "$root/tools/loam" "$root/lakefile.lean" "$root/lean-toolchain" \
    "$root/lake-manifest.json" "$root/Loam/Tui/terminal_native.c" \
    "$rsp" "${sources[@]}" | hash_files
}

binary_identity() {
  [[ -x "$1" ]] || return 1
  # Bind the check to this artifact without hashing the large executable on each
  # launch. Include nanosecond change time so restoring mtime does not hide edits.
  if [[ "$(uname -s)" == "Darwin" ]]; then
    stat -f '%d:%i:%z:%Fm:%Fc' "$1"
  else
    stat -c '%d:%i:%s:%y:%z' "$1"
  fi
}

run_target() {
  local target="$1"
  shift

  local bin="$root/.lake/build/bin/$target"
  local receipt="$bin.launcher-check" before after identity checked
  before="$(target_input_fingerprint "$target" 2>/dev/null)" || before=""
  identity="$(binary_identity "$bin" 2>/dev/null)" || identity=""
  checked="$(printf '%s\n%s\n' "$before" "$identity")"
  if [[ "${LOAM_FORCE_BUILD:-0}" != "1" && -n "$before" && -n "$identity" &&
        -f "$receipt" && "$(<"$receipt")" == "$checked" ]]; then
    exec "$bin" "$@"
  fi

  # A failed check must not leave a previously accepted receipt available.
  rm -f "$receipt"
  local build_log temporary
  build_log="$(mktemp -t loam-build.XXXXXX)"
  if lake build "$target" >"$build_log" 2>&1; then
    rm -f "$build_log"
    after="$(target_input_fingerprint "$target" 2>/dev/null)" || after=""
    identity="$(binary_identity "$bin" 2>/dev/null)" || identity=""
    # No-op Lake success is enough: the executable need not get a new mtime.
    # Changing inputs/inventory during the check never earns a reusable receipt.
    if [[ -n "$before" && "$before" == "$after" && -n "$identity" ]]; then
      temporary="$(mktemp "$receipt.XXXXXX")"
      printf '%s\n%s\n' "$after" "$identity" >"$temporary"
      mv -f "$temporary" "$receipt"
    fi
    exec "$bin" "$@"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    return 1
  fi
}

print_help() {
  cat <<'EOF'
LOAM practical dogfood

Open the production TUI (also the default with no arguments):
  ./tools/loam
  ./tools/loam tui [LOAM_DATA_DIR]

Start an independent household in a NEW directory (never resets existing data):
  ./tools/loam init NEW_DATA_DIR

Diagnose whether the New-only production startup read boundary is coherent:
  ./tools/loam doctor [LOAM_DATA_DIR]
  This command is read-only and never repairs or rewrites household facts.

Print the evidence-aware Balances report as plain text:
  ./tools/loam report balances [LOAM_DATA_DIR]
  The output is the same shared RoleBalance presentation without TUI paging.

Publish one complete current quantity observation image:
  ./tools/loam current-quantity-anchor LOCUS MEASURE QUANTITY [LOCUS MEASURE QUANTITY ...]
  LOAM_DATA_DIR selects the household data root; otherwise ../loam-data is used.

Administer one Measure presentation scale:
  ./tools/loam measure-scale LOAM_DATA_DIR MEASURE SCALE
  Used Measures refuse ordinary scale changes; explicit migration is separate.

Record one balanced single-Measure movement into actual.loam:
  ./tools/loam movement [LOAM_DATA_DIR]
  LOAM_MEASURE selects the Measure; default is jpy.

Review one machine-readable Movement proposal without publishing:
  ./tools/loam movement-proposal PROPOSAL_FILE [LOAM_DATA_DIR]

Record one explicitly accepted machine-readable Movement proposal:
  ./tools/loam movement-proposal-record PROPOSAL_FILE [LOAM_DATA_DIR]

Move single-Measure spending capacity:
  ./tools/loam capacity CAPACITY_FILE
  LOAM_MEASURE selects the Measure; default is jpy.

Show spending capacity:
  ./tools/loam capacity show CAPACITY_FILE

Scriptable routing and budget projection:
  ./tools/loam actual-routing ...
  ./tools/loam scheduled-routing ...
  ./tools/loam budget-window DATA_ROOT START END PURPOSE|--all

Portable exports:
  ./tools/loam export journal ACTUAL_FILE OUTPUT_FILE
  ./tools/loam export pta ACTUAL_FILE ACCOUNTING_ROLE_FILE OUTPUT_FILE
  ./tools/loam export beancount [--partial|--suspense] ...

Show current Scheduled evidence:
  ./tools/loam open-scheduled SCHEDULED_FILE DATA_ROOT

Review current Actual records (optional YYYY-MM-DD, /text search, or u for undated):
  ./tools/loam review ACTUAL_FILE [QUERY]

Show recorded quantities:
  ./tools/loam summary ACTUAL_FILE

Correct movements and occurrence dates from the production TUI:
  ./tools/loam

Zero-origin coverage has no ordinary household writer. Change it only during an explicit reconstruction/cutover.

For lower-level commands:
  ./tools/loam help low-level
EOF
}

if [[ $# -eq 0 ]]; then
  run_target loam
fi

if [[ "${1:-}" == "shadow-audit" ]]; then
  shift
  run_target loamShadowAudit "$@"
fi

if [[ "${1:-}" == "shadow-quantity" ]]; then
  shift
  run_target loamShadowQuantity "$@"
fi

if [[ "${1:-}" == "help" && "${2:-}" != "low-level" ]]; then
  print_help
  exit 0
fi

run_target loam "$@"
