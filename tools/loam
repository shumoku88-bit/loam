#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

binary=".lake/build/bin/loam"

binary_is_current() {
  [[ -x "$binary" ]] || return 1

  if find Loam -type f -name '*.lean' -newer "$binary" -print -quit | grep -q .; then
    return 1
  fi

  for input in lakefile.lean lake-manifest.json lean-toolchain; do
    if [[ -e "$input" && "$input" -nt "$binary" ]]; then
      return 1
    fi
  done

  return 0
}

run_loam() {
  if binary_is_current; then
    exec "$binary" "$@"
  fi

  echo "Building LOAM..."
  local build_log
  build_log="$(mktemp -t loam-build.XXXXXX)"
  if lake build loam >"$build_log" 2>&1; then
    rm -f "$build_log"
    exec "$binary" "$@"
  else
    cat "$build_log" >&2
    rm -f "$build_log"
    exit 1
  fi
}

if [[ $# -eq 0 ]]; then
  memory_file="scratch/dogfood/memory.loam"
  correction_file="scratch/dogfood/corrections.loam"
  mkdir -p "$(dirname "$memory_file")"

  cat <<'EOF'
LOAM

What do you want to do?
1. Record spending
2. Review what I recorded
3. Show recorded quantities
4. Correct a spending record
5. Show effective quantities
6. Review correction integrity
q. Quit
EOF
  printf '> '
  IFS= read -r choice

  case "$choice" in
    1)
      run_loam spend "$memory_file"
      ;;
    2)
      if [[ ! -e "$memory_file" ]]; then
        echo "Nothing recorded yet."
        exit 0
      fi
      run_loam review "$memory_file"
      ;;
    3)
      if [[ ! -e "$memory_file" ]]; then
        echo "Nothing recorded yet."
        exit 0
      fi
      run_loam summary "$memory_file"
      ;;
    4)
      run_loam correct "$memory_file" "$correction_file"
      ;;
    5)
      run_loam effective "$memory_file" "$correction_file"
      ;;
    6)
      run_loam correction-integrity "$memory_file" "$correction_file"
      ;;
    q|Q)
      exit 0
      ;;
    *)
      echo "loam: choice not understood" >&2
      exit 2
      ;;
  esac
fi

run_loam "$@"
