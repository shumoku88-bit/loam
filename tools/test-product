    if [[ "$group" =~ ^[A-Za-z0-9_]+$ ]] && [[ -f "Loam/Tests/$group.lean" ]]; then
      tests=("$group")
    else
      echo "unknown test group or test: $group" >&2
      echo "expected a named group or a Loam/Tests/<TestName>.lean module" >&2
      exit 2
    fi
    ;;
