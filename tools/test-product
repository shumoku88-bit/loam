#!/usr/bin/env bash
set -euo pipefail

run() {
  printf '==> %s\n' "$*"
  "$@"
}

accounting_tests=(
  RoleFlowReview
  CurrentBalanceReview
  RoleBalanceReview
  RoleBalanceAnswerability
  HistoricalBalanceReview
  OpeningPositionReview
  MultimeasureSpendReview
  CurrentQuantityAnchor
  CurrentQuantityPresence
  CurrentQuantityAnchorCli
)

cycle_funding_tests=(
  CycleFundingInspection
  BalanceReview
  CurrentCoverageReview
)

capacity_tests=(
  CapacityPublisher
  NormalizedCapacityPersistence
  CapacityDogfood
  CapacityReview
)

actual_routing_tests=(
  ActualRoutingPersistence
)

scheduled_routing_tests=(
  ScheduledRoutingPersistence
  ScheduledCommitmentHeadroom
  ScheduledRoutingPublisher
)

scheduled_lifecycle_tests=(
  ScheduledLifecyclePersistence
  ScheduledCreationPublisher
  ScheduledReplacementPublisher
  ScheduledTerminalPublisher
)

movement_proposal_tests=(
  MovementProposal
  MovementProposalRecord
)

actual_validity_tests=(
  MovementOperationEvidence
  NormalizedActualPersistenceTest
  ActualAuthorityDetailed
  ActualValidityPublisher
)

purpose_catalog_tests=(
  PurposeCatalog
  TuiPurposeLabels
)

attention_tests=(
  AttentionPersistence
  TuiAttentionAdministration
)

event_merchant_tests=(
  EventMerchantPublisher
  TuiEventMerchant
)

practical_slice_b_additional_tests=(
  CurrentCoverageInspection
  CounterpointFiveWorlds
  FourVoiceCompatibilityV1
  FourVoiceCompatibilityV2
  FourVoiceCompatibilityV3
  FourVoiceCompatibilityV4
  FourVoiceCompatibilityV5
  FourVoiceCompatibilityV6
)

practical_slice_b_tests=(
  ScheduledCommitmentHeadroom
  "${practical_slice_b_additional_tests[@]}"
  CurrentCoverageReview
)

practical_slice_a2_tests=(
  Capacity
  ActualRoutingConsumption
  CorrectedActualConsumption
  CapacityHouseholdStory
)

representative_tests=(
  BoundedHistorySupport
)

group="${1:-all}"
case "$group" in
  accounting)
    tests=("${accounting_tests[@]}")
    ;;
  cycle-funding)
    tests=("${cycle_funding_tests[@]}")
    ;;
  capacity)
    tests=("${capacity_tests[@]}")
    ;;
  actual-routing)
    tests=("${actual_routing_tests[@]}")
    ;;
  scheduled-routing)
    tests=("${scheduled_routing_tests[@]}")
    ;;
  scheduled-lifecycle)
    tests=("${scheduled_lifecycle_tests[@]}")
    ;;
  movement-proposal)
    tests=("${movement_proposal_tests[@]}")
    ;;
  actual-validity)
    tests=("${actual_validity_tests[@]}")
    ;;
  purpose-catalog)
    tests=("${purpose_catalog_tests[@]}")
    ;;
  attention)
    tests=("${attention_tests[@]}")
    ;;
  event-merchant)
    tests=("${event_merchant_tests[@]}")
    ;;
  practical-slice-b)
    tests=("${practical_slice_b_tests[@]}")
    ;;
  practical-slice-a2)
    tests=("${practical_slice_a2_tests[@]}")
    ;;
  all)
    tests=(
      "${accounting_tests[@]}"
      "${cycle_funding_tests[@]}"
      "${capacity_tests[@]}"
      "${actual_routing_tests[@]}"
      "${scheduled_routing_tests[@]}"
      "${scheduled_lifecycle_tests[@]}"
      "${movement_proposal_tests[@]}"
      "${actual_validity_tests[@]}"
      "${purpose_catalog_tests[@]}"
      "${attention_tests[@]}"
      "${event_merchant_tests[@]}"
      "${practical_slice_b_additional_tests[@]}"
      "${practical_slice_a2_tests[@]}"
      "${representative_tests[@]}"
    )
    ;;
  *)
    echo "unknown test group: $group" >&2
    echo "expected: all, accounting, cycle-funding, capacity, actual-routing, scheduled-routing, scheduled-lifecycle, movement-proposal, actual-validity, purpose-catalog, attention, event-merchant, practical-slice-b, practical-slice-a2" >&2
    exit 2
    ;;
esac

extra_targets=()
case "$group" in
  movement-proposal|all)
    extra_targets+=(loamMovementProposal loamMovementProposalRecord)
    ;;
esac

if (("${#extra_targets[@]}" > 0)); then
  run lake build "${extra_targets[@]}"
fi

modules=()
for test_name in "${tests[@]}"; do
  modules+=("Loam.Tests.$test_name")
done
run lake build "${modules[@]}"

for test_name in "${tests[@]}"; do
  case "$test_name" in
    BalanceReview)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/balance-review"
      ;;
    CapacityPublisher)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/capacity-publisher"
      ;;
    CapacityReview)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/capacity-review"
      ;;
    CurrentCoverageReview)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/current-coverage-review"
      ;;
    MovementProposal)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/movement-proposal"
      ;;
    MovementProposalRecord)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/movement-proposal-record"
      ;;
    ActualValidityPublisher)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/actual-validity-publisher"
      ;;
    AttentionPersistence)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/attention-administration"
      ;;
    EventMerchantPublisher)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/event-merchant-publisher"
      ;;
    TuiEventMerchant)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/tui-event-merchant"
      ;;
    ScheduledCreationPublisher)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/scheduled-creation-publisher"
      ;;
    ScheduledLifecyclePersistence)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/scheduled-lifecycle"
      ;;
    ScheduledReplacementPublisher)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/scheduled-replacement-publisher"
      ;;
    ScheduledRoutingPublisher)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/scheduled-routing-publisher"
      ;;
    ScheduledTerminalPublisher)
      run lake env lean --run "Loam/Tests/$test_name.lean" "$(mktemp -d)/scheduled-terminal-publisher"
      ;;
    *)
      run lake env lean --run "Loam/Tests/$test_name.lean"
      ;;
  esac
done
